# ==============================================================================
# Admin Panel Environment Variables (apps/admin)
# SENSITIVE: Never commit this file or your .env.local to version control!
# Copy this file to .env.local and fill in your private admin credentials and keys.
# ==============================================================================

# Supabase Project URL (e.g. https://xyzcompany.supabase.co)
NEXT_PUBLIC_SUPABASE_URL=

# Supabase Service Role Key (Bypasses RLS - keep strictly secret, server-side only)
SUPABASE_SERVICE_ROLE_KEY=

# Admin Master Credentials (used for initial admin authentication)
ADMIN_EMAIL=
ADMIN_PHONE=

# Random 32+ character secret key used for signing admin session tokens
ADMIN_SESSION_SECRET=

