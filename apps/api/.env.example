# ==============================================================================
# API (apps/api) environment variables
# Copy this file to .env and fill in the values. NEVER commit the .env file.
# ==============================================================================

NODE_ENV=development
PORT=4100

# PostgreSQL connection string. We use Supabase only as the database (storage).
# Supabase Dashboard -> Connect -> "Session pooler" connection string, e.g.
#   postgresql://postgres.<project-ref>:<db-password>@aws-0-<region>.pooler.supabase.com:5432/postgres
# Local Postgres also works: postgres://user:password@localhost:5432/sudoku
DATABASE_URL=
# Supabase requires SSL: set to true. Local Postgres: false.
DATABASE_SSL=false
# Supabase only: path to its CA certificate, so the connection is verified (not just encrypted).
# Download it from Supabase Dashboard -> Project Settings -> Database -> SSL Configuration.
# Example: DATABASE_SSL_CA_FILE=./certs/supabase-ca.crt  (this certificate is public, not a secret)
DATABASE_SSL_CA_FILE=

# The public website (Next.js) origin. Only this origin may call the API from a browser.
FRONTEND_URL=http://localhost:3000
# Public URL of this API. Used to build the Google OAuth redirect URI:
#   {API_PUBLIC_URL}/api/auth/google/callback  (register this exact URL in Google Cloud Console)
API_PUBLIC_URL=http://localhost:4100

# Number of reverse proxies in front of the API (Render/Railway: 1). Needed for correct client IPs in rate limiting.
TRUST_PROXY=0

# Random secret, at least 32 characters. Signs the short-lived Google OAuth state cookie.
# Generate one with: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
COOKIE_SECRET=

# Random secret, at least 32 characters, DIFFERENT from COOKIE_SECRET. Signs the access-token JWTs.
JWT_SECRET=

# Access token (JWT cookie) lifetime in minutes. The website refreshes it automatically.
ACCESS_TOKEN_TTL_MINUTES=12
# Refresh token lifetime in days. Each refresh issues a new one (rotation).
REFRESH_TOKEN_TTL_DAYS=7

# Cookie settings.
# "lax" when the website and API share one site (e.g. example.com + api.example.com). "none" only if they are on different sites.
COOKIE_SAMESITE=lax
# Optional: share the cookie across subdomains, e.g. .example.com
COOKIE_DOMAIN=

# Google OAuth (Google Cloud Console -> APIs & Services -> Credentials -> OAuth client ID, type "Web application").
# Leave empty to disable Google sign-in locally.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Email delivery. "console" prints emails to the terminal (local development only). "smtp" sends real emails.
EMAIL_TRANSPORT=console
EMAIL_FROM="Vamshi Finance <no-reply@example.com>"
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
