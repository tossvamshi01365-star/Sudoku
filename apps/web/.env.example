# ==============================================================================
# Public Website Environment Variables (apps/web)
# Copy this file to .env.local and fill in the values.
# No secrets belong here: everything starting with NEXT_PUBLIC_ is visible in the browser.
# ==============================================================================

# Public URL of our Express API (apps/api). Locally: http://localhost:4100
# In production use a subdomain of the website, e.g. https://api.example.com,
# so login cookies stay first-party.
NEXT_PUBLIC_API_URL=http://localhost:4100
